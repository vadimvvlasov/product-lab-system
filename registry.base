filters:
  and:
    - '!file.inFolder("templates")'
    - kind == "idea" || kind == "experiment"
views:
  - type: table
    name: Пул идей
    filters:
      and:
        - kind == "idea"
        - status == "screened"
        - score >= 60
    order:
      - file.name
      - project
      - score
      - confidence
      - test_cost
      - track
      - origin
      - review_date
    sort:
      - property: score
        direction: DESC
  - type: table
    name: Идеи
    filters:
      and:
        - kind == "idea"
    order:
      - file.name
      - project
      - status
      - track
      - score
      - confidence
      - test_cost
      - portfolio_value
      - review_date
    sort:
      - property: score
        direction: DESC
  - type: table
    name: Эксперименты в работе
    filters:
      and:
        - kind == "experiment"
        - status != "closed"
    order:
      - file.name
      - project
      - idea
      - method
      - track
      - status
      - timebox_hours
      - spent_hours
      - review_date
    sort:
      - property: review_date
        direction: ASC
  - type: table
    name: Review просрочен
    filters:
      and:
        - review_date < today()
        - '!(status == "closed" || status == "parked" || status == "killed")'
    order:
      - file.name
      - kind
      - status
      - owner
      - review_date
    sort:
      - property: review_date
        direction: ASC
  - type: table
    name: Portfolio без timebox
    filters:
      and:
        - track == "portfolio"
        - timebox.isEmpty()
    order:
      - file.name
      - kind
      - status
      - owner
  - type: table
    name: Перерасход времени
    filters:
      and:
        - 'kind == "experiment"'
        - 'status != "closed"'
        - 'spent_hours >= timebox_hours'
    order:
      - file.name
      - status
      - timebox_hours
      - spent_hours
      - owner
  - type: table
    name: Калибровка
    filters:
      and:
        - 'kind == "experiment"'
        - 'status == "closed"'
    order:
      - file.name
      - idea
      - method
      - score_at_launch
      - confidence_at_launch
      - decision
      - signal
      - spent_hours
    sort:
      - property: review_date
        direction: DESC
