filters:
  and:
    - '!file.inFolder("templates")'
    - kind == "idea" || kind == "experiment"
views:
  - type: table
    name: Пул идей
    filters:
      and:
        - kind == "idea"
        - status == "screened"
        - score >= 60
    order:
      - file.name
      - project
      - score
      - confidence
      - test_cost
      - track
      - origin
      - weeks_to_revenue_low
      - weeks_to_revenue_high
      - weeks_to_revenue_basis
      - review_date
    sort:
      - property: weeks_to_revenue
        direction: ASC
  - type: table
    name: Идеи
    filters:
      and:
        - kind == "idea"
    order:
      - file.name
      - project
      - status
      - track
      - score
      - confidence
      - test_cost
      - portfolio_value
      - weeks_to_revenue_low
      - weeks_to_revenue_high
      - weeks_to_revenue_basis
      - review_date
    sort:
      - property: score
        direction: DESC
  - type: table
    name: C в тесте
    filters:
      and:
        - kind == "idea"
        - confidence == "C"
        - status == "testing"
        - test_cost == "S"
    order:
      - file.name
      - project
      - score
      - test_cost
      - budget_until
      - owner
  - type: table
    name: Эксперименты в работе
    filters:
      and:
        - kind == "experiment"
        - status != "closed"
    order:
      - file.name
      - project
      - idea
      - method
      - track
      - status
      - timebox_hours
      - spent_hours
      - review_date
    sort:
      - property: review_date
        direction: ASC
  - type: table
    name: Review просрочен
    filters:
      and:
        - review_date < today()
        - '!(status == "closed" || status == "parked" || status == "killed")'
    order:
      - file.name
      - kind
      - status
      - owner
      - review_date
    sort:
      - property: review_date
        direction: ASC
  - type: table
    name: Portfolio без timebox
    filters:
      and:
        - track == "portfolio"
        - timebox_hours.isEmpty()
    order:
      - file.name
      - kind
      - status
      - owner
  - type: table
    name: Перерасход времени
    filters:
      and:
        - kind == "experiment"
        - status != "closed"
        - spent_hours >= timebox_hours
    order:
      - file.name
      - status
      - timebox_hours
      - spent_hours
      - owner
  - type: table
    name: Live без timebox/review
    filters:
      and:
        - kind == "experiment"
        - status == "live"
        - timebox_hours.isEmpty() || (review_date.isEmpty() && review_condition.isEmpty())
    order:
      - file.name
      - project
      - idea
      - method
      - timebox_hours
      - review_date
      - review_condition
      - owner
  - type: table
    name: Без review date
    filters:
      and:
        - kind == "experiment"
        - status != "closed"
        - review_date.isEmpty() && review_condition.isEmpty()
    order:
      - file.name
      - project
      - status
      - timebox_hours
      - review_date
      - review_condition
      - owner
  - type: table
    name: Эксперименты без timebox/review
    filters:
      and:
        - kind == "experiment"
        - status != "draft"
        - status != "closed"
        - timebox_hours.isEmpty() || (review_date.isEmpty() && review_condition.isEmpty()) || stop_rule.isEmpty() || owner.isEmpty()
    order:
      - file.name
      - project
      - status
      - timebox_hours
      - review_date
      - review_condition
      - stop_rule
      - owner
  - type: table
    name: Идеи без бюджета
    filters:
      and:
        - kind == "idea"
        - status == "testing" || status == "researching"
        - budget_until.isEmpty() || budget_signal.isEmpty()
    order:
      - file.name
      - project
      - status
      - budget_until
      - budget_signal
      - owner
  - type: table
    name: Калибровка
    filters:
      and:
        - kind == "experiment"
        - status == "closed"
    order:
      - file.name
      - idea
      - method
      - score_at_launch
      - confidence_at_launch
      - primary_result
      - exposure
      - decision
      - decision_reason
      - signal
      - spent_hours
    sort:
      - property: review_date
        direction: DESC
  - type: table
    name: Закрытые без чисел
    filters:
      and:
        - kind == "experiment"
        - status == "closed"
        - primary_result.isEmpty() || decision_reason.isEmpty()
    order:
      - file.name
      - idea
      - method
      - decision
      - exposure
      - primary_result
      - decision_reason
      - owner
  - type: table
    name: Доходность
    filters:
      and:
        - kind == "experiment"
        - spent_hours > 0
    order:
      - file.name
      - idea
      - track
      - status
      - spent_hours
      - revenue
      - cash_cost_usd
      - signal
    sort:
      - property: idea
        direction: ASC
  - type: table
    name: Часы portfolio
    filters:
      and:
        - kind == "experiment"
        - track == "portfolio"
    order:
      - file.name
      - project
      - status
      - timebox_hours
      - spent_hours
  - type: table
    name: Бюджет идеи истёк
    filters:
      and:
        - kind == "idea"
        - status == "testing" || status == "researching"
        - budget_until < today()
    order:
      - file.name
      - project
      - budget_signal
      - budget_until
      - owner
